# Telegram API credentials from https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Bot token from @BotFather
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExam

# Your numeric Telegram user ID (get it from @userinfobot)
OWNER_ID=123456789

# MongoDB. With docker compose's local mongo use mongodb://mongo:27017
# For Atlas use mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://mongo:27017
DB_NAME=infinix_postbot

# IANA timezone used for scheduling input and display, e.g. UTC, Asia/Kolkata, Europe/London
TIMEZONE=UTC

# Optional
# SCHEDULER_INTERVAL=15
# LOG_LEVEL=INFO

# docker compose: start the bundled MongoDB. Delete this line when MONGO_URI points to Atlas.
COMPOSE_PROFILES=local-mongo
